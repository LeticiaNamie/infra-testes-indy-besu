    "ssh_commands": {
      "value": [
        "ssh -i ~/.ssh/besu-key ubuntu@98.82.204.30  # Node-1 bootnode (10.0.1.10)",
        "ssh -i ~/.ssh/besu-key ubuntu@34.205.8.203  # Node-2 validator (10.0.1.11)"
