  "lineage": "91b03569-57a0-fc64-c7f9-c020c253bc18",
  "outputs": {
    "check_deploy_artifacts_command": {
      "value": "ssh -i ~/.ssh/besu-key ubuntu@52.6.202.213 'ls -lah /home/ubuntu/deploy-artifacts/'",
      "type": "string"
    },
    "check_network_info_command": {
      "value": "ssh -i ~/.ssh/besu-key ubuntu@52.6.202.213 'cat /home/ubuntu/deploy-artifacts/network-info.json'",
      "type": "string"
    },
    "deploy_completion_message": {
      "value": "==== Etapa 2: Deploy dos Contratos — Próximos Passos ====\n    \nPara verificar se o deploy foi bem-sucedido:\n    \n1. Consulte as informações da rede e chainId:\n   ssh -i ~/.ssh/besu-key ubuntu@52.6.202.213 'cat /home/ubuntu/deploy-artifacts/network-info.json'\n    \n2. Liste os artefatos de deploy:\n   ssh -i ~/.ssh/besu-key ubuntu@52.6.202.213 'ls -lah /home/ubuntu/deploy-artifacts/'\n    \n3. Verifique o log completo da Etapa 2:\n   ssh -i ~/.ssh/besu-key ubuntu@52.6.202.213 'tail -100 /var/log/besu-setup.log'\n    \n4. Os contratos foram implantados e seus endereços estão registrados em:\n   /home/ubuntu/deploy-artifacts/deployments/\n    \n5. Os ABIs compilados estão em:\n   /home/ubuntu/contracts-indy-besu/artifacts/\n",
      "type": "string"
    },
    "log_command": {
      "value": "ssh -i ~/.ssh/besu-key ubuntu@52.6.202.213 'tail -f /var/log/besu-setup.log'",
      "type": "string"
    },
    "public_ip": {
      "value": "52.6.202.213",
      "type": "string"
    },
    "rpc_url": {
      "value": "http://52.6.202.213:8545",
      "type": "string"
    },
    "s3_bucket_name": {
      "value": "tests-with-caliper-results-410645763463",
      "type": "string"
    },
    "s3_check_command": {
      "value": "aws s3 ls s3://tests-with-caliper-results-410645763463/ --recursive",
      "type": "string"
    },
    "ssh_command": {
      "value": "ssh -i ~/.ssh/besu-key ubuntu@52.6.202.213",
      "type": "string"
    }
  },
