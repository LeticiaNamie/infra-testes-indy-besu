    "validation_commands": {
      "value": "# Verificar blockNumber no Node-1:\ncurl -s -X POST --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}' http://44.199.113.186:8545\n\n# Verificar peers conectados (deve retornar 0x1 com 2 nós):\ncurl -s -X POST --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_peerCount\",\"params\":[],\"id\":1}' http://44.199.113.186:8545\n",
      "type": "string"
    }
  },
