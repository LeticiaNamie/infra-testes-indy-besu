      "value": "ssh -i ~/.ssh/besu-key ubuntu@13.223.85.247  # Caliper",
      "type": "string"
    },
    "deploy_artifacts_commands": {
      "value": "# Verificar network-info.json (chainId, rpcUrl):\nssh -i ~/.ssh/besu-key ubuntu@52.72.51.216 'cat /home/ubuntu/deploy-artifacts/network-info.json'\n\n# Verificar endereços dos contratos (journal Ignition):\nssh -i ~/.ssh/besu-key ubuntu@52.72.51.216 'ls /home/ubuntu/deploy-artifacts/deployments/'\n\n# Verificar artefatos no S3:\naws s3 ls s3://besu-distributed-data-410645763463/artifacts/ --recursive\n",
      "type": "string"
    },
