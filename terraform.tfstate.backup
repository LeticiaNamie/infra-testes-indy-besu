  "outputs": {
    "caliper_log_command": {
      "value": "ssh -i ~/.ssh/besu-key ubuntu@44.214.139.60 'tail -f /home/ubuntu/besu-setup.log'",
      "type": "string"
    },
    "caliper_public_ip": {
      "value": "44.214.139.60",
      "type": "string"
    },
    "caliper_results_commands": {
      "value": "# Listar todas as execuções:\naws s3 ls s3://besu-distributed-data-410645763463/caliper-results/ --recursive\n\n# Baixar todos os CSVs de uma execução (substituir \u003ctimestamp\u003e):\naws s3 cp s3://besu-distributed-data-410645763463/caliper-results/\u003ctimestamp\u003e/ ./caliper-results/ --recursive\n",
      "type": "string"
    },
    "caliper_ssh_command": {
      "value": "ssh -i ~/.ssh/besu-key ubuntu@44.214.139.60  # Caliper",
      "type": "string"
    },
    "deploy_artifacts_commands": {
      "value": "# Verificar network-info.json (chainId, rpcUrl):\nssh -i ~/.ssh/besu-key ubuntu@98.82.204.30 'cat /home/ubuntu/deploy-artifacts/network-info.json'\n\n# Verificar endereços dos contratos (journal Ignition):\nssh -i ~/.ssh/besu-key ubuntu@98.82.204.30 'ls /home/ubuntu/deploy-artifacts/deployments/'\n\n# Verificar artefatos no S3:\naws s3 ls s3://besu-distributed-data-410645763463/artifacts/ --recursive\n",
      "type": "string"
    },
    "log_commands": {
      "value": [
        "ssh -i ~/.ssh/besu-key ubuntu@98.82.204.30 'tail -f /home/ubuntu/besu-setup.log'  # Node-1",
        "ssh -i ~/.ssh/besu-key ubuntu@34.205.8.203 'tail -f /home/ubuntu/besu-setup.log'  # Node-2"
      ],
      "type": [
        "tuple",
        [
          "string",
          "string"
        ]
      ]
    },
    "node1_public_ip": {
      "value": "98.82.204.30",
      "type": "string"
    },
    "node2_public_ip": {
